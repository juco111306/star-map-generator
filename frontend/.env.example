# ==============================================================================
# Stellaire Atelier - Environment Configuration
# ==============================================================================

# Public site URL (used in transactional emails for links)
NEXT_PUBLIC_SITE_URL=https://stellaireshop.com

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=https://star-map-generator.onrender.com

# ------------------------------------------------------------------------------
# Transactional Email Providers (Choose one: Resend, SendGrid, Brevo, or Postmark)
# ------------------------------------------------------------------------------
# Resend is recommended for Next.js / Vercel (100 free emails/day at resend.com):
RESEND_API_KEY=

# SendGrid alternative:
# SENDGRID_API_KEY=

# Brevo (formerly Sendinblue) alternative:
# BREVO_API_KEY=

# Postmark alternative:
# POSTMARK_SERVER_TOKEN=

# Sender and reply-to addresses
EMAIL_FROM=Stellaire Atelier <info@stellaireshop.com>
EMAIL_REPLY_TO=info@stellaireshop.com

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Secret salt for generating unguessable HMAC tokens for PDF downloads:
ORDER_SECURITY_SECRET=stellaire_celestial_secret_token_salt_2026
